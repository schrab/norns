[Unit]
After=sound.target
# Restarting norns orphans jackd's shared-memory registry:
#   JACK semaphore error: semop (Invalid argument)
#   jack_shm_lock_registry fails... / jack_client_open() status = 17
# jackd stays active but serves nothing, and because SYSTEM>RESTART only
# touches norns-main, the wedge is unrecoverable without restarting jackd.
# PartOf propagates norns-main stop/restart to jackd, so they cycle
# together and the registry is rebuilt from a clean slate.
PartOf=norns-main.service

[Service]
Type=simple
User=we
Group=we
Environment="JACK_NO_AUDIO_RESERVATION=1"
LimitRTPRIO=95
LimitMEMLOCK=infinity
# Fates audio codec is a WM8731 on card sndrpiproto, not monome's sndrpimonome
# jackd 1.9.22 is a source build in /usr/local (system jackd2 1.9.12 libs are
# dpkg-diverted aside as /lib/arm-linux-gnueabihf/*.distrib). Rollback:
# dpkg-divert --rename --remove the two libs, revert this path, daemon-reload.
# Do not mix versions: a 1.9.12 server cannot serve 1.9.22 clients (protocol 8 vs 9).
ExecStart=/usr/local/bin/jackd -R -P 95 -d alsa -d hw:sndrpiproto -r 48000 -n 3 -p 128 -S -s
ExecStartPost=/usr/bin/jack_wait -w -t 10
TimeoutStopSec=1

[Install]
WantedBy=norns.target
